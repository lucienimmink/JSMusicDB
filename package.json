{
  "scripts": {
    "lint:eslint": "eslint .",
    "format:eslint": "eslint . --fix",
    "lint:prettier": "prettier \"**/*.js\" \"**/*.ts\" --check --ignore-path .gitignore",
    "format:prettier": "prettier \"**/*.js\" \"**/*.ts\" --write --ignore-path .gitignore",
    "lint": "pnpm run lint:prettier && pnpm run lint:eslint",
    "format": "pnpm run format:prettier && pnpm run format:eslint",
    "build": "vite build .",
    "preview": "vite preview .",
    "start": "vite && pnpm run analyse:watch",
    "dev": "pnpm run start",
    "postversion": "git push --follow-tags",
    "zip": "node scripts/zip.js",
    "deploy": "node scripts/deploy.js",
    "zip:deploy": "pnpm run zip && pnpm run deploy",
    "build:zip:deploy": "pnpm run build && pnpm run zip && pnpm run deploy",
    "bzd": "pnpm run build:zip:deploy",
    "analyse": "custom-elements-manifest analyze --litelement --outdir dist --globs \"src/**/*.ts\"",
    "analyse:watch": "custom-elements-manifest analyze --litelement --outdir dist --globs \"src/**/*.ts\" --watch"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "8.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "node-fetch": "^3.3.2",
    "pinst": "^3.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "npm:@typescript/typescript6",
    "vite": "^8.2.2",
    "vite-plugin-package-version": "^1.1.0",
    "vite-plugin-preload": "^0.7.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-broadcast-update": "^7.4.1",
    "zip-a-folder": "^7.0.0"
  },
  "eslintConfig": {
    "extends": [
      "@open-wc/eslint-config",
      "eslint-config-prettier"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "lint-staged": {
    "*.ts": [
      "pnpm run lint",
      "pnpm run format"
    ]
  },
  "name": "jsmusicdb",
  "version": "3.56.0",
  "description": "Web standards music database and player",
  "author": "Lucien Immink",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/lucienimmink/JSMusicDB",
    "type": "github"
  },
  "type": "module",
  "dependencies": {
    "@addasoft/musicdbcore": "^1.13.0",
    "@addasoft/timespan": "^1.1.6",
    "@lit-labs/router": "^0.1.4",
    "@lit-labs/virtualizer": "^2.1.1",
    "@thebespokepixel/es-tinycolor": "^3.1.0",
    "audiomotion-analyzer": "^4.5.4",
    "diacritics-normalizr": "^1.0.3",
    "fast-average-color": "^9.5.2",
    "fuse.js": "^7.5.0",
    "idb-keyval": "^6.3.0",
    "lit": "^3.3.3",
    "tslib": "^2.8.1",
    "urlpattern-polyfill": "^10.1.0"
  },
  "customElements": "dist/custom-elements.json",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "pinst@3.0.0": true,
    "rs-module-lexer@2.8.0": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  }
}
